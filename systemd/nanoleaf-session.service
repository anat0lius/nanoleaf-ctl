[Unit]
Description=Nanoleaf Blocks Session Lifecycle Manager
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ender/.local/bin/nanoleaf-ctl session-start
ExecStop=/home/ender/.local/bin/nanoleaf-ctl session-end
TimeoutStopSec=6

[Install]
WantedBy=graphical-session.target
